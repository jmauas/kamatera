# Kamatera API
CLIENT_ID=your_kamatera_client_id
API_SECRET=your_kamatera_api_secret
SERVER_ID=your_kamatera_server_id

# Geolocalización (positionstack)
GEOCODE_KEY=your_geocode_api_key

# Token de servicio: SOLO para cron-job.org y pruebas (header "token"). No va en el frontend.
TOKEN=generate_a_long_random_value

# El panel es público; esta contraseña protege solo la Configuración (CPU/RAM/disco)
CONFIG_PASSWORD=choose_a_password
# Firma de la cookie de sesión (mínimo 16 caracteres, aleatorio)
SESSION_SECRET=generate_a_long_random_value

# Supabase
SUPABASE_URL=https://your-project.supabase.co
# Clave service_role (solo servidor, nunca en el frontend). Con RLS activado es la que se necesita.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
# Respaldo si no definís SUPABASE_SERVICE_KEY (clave anónima)
SUPABASE_KEY=
